classDiagram
    direction TB

    %% ─── Entités fonctionnelles ────────────────────────────

    class User {
        -Long id
        -String name
        -String email
        -String password
        -Role role
        -String region
        -LocalDateTime createdAt
    }

    class Product {
        -Long id
        -String name
        -String category
        -String unit
    }

    class Region {
        -Long id
        -String name
    }

    class OfficialPrice {
        -Long id
        -Double price
        -String currency
        -LocalDate validFrom
        -LocalDate validTo
        -LocalDateTime createdAt
        +isActive() Boolean
    }

    class Report {
        -Long id
        -Double priceObserved
        -Double officialPrice
        -Double lat
        -Double lng
        -String description
        -ReportStatus status
        -Priority priority
        -Integer confirmationCount
        -LocalDateTime createdAt
        +getEcart() Double
    }

    class Merchant {
        -Long id
        -String name
        -String address
        -Double lat
        -Double lng
        -String status
    }

    class Mission {
        -Long id
        -String title
        -String description
        -MissionStatus status
        -LocalDate scheduledDate
        -LocalDateTime createdAt
    }

    class Infraction {
        -Long id
        -String description
        -Double fineAmount
        -InfractionStatus status
        -LocalDateTime createdAt
    }

    class Notification {
        -Long id
        -String message
        -String type
        -Boolean isRead
        -LocalDateTime createdAt
    }

    %% ─── Énumérations ──────────────────────────────────────

    class Role {
        <<enumeration>>
        ADMIN
        CONSUMER
        AGENT
        MERCHANT
    }

    class ReportStatus {
        <<enumeration>>
        PENDING
        VERIFIED
        RESOLVED
        REJECTED
    }

    class Priority {
        <<enumeration>>
        LOW
        NORMAL
        HIGH
        CRITICAL
    }

    class MissionStatus {
        <<enumeration>>
        PLANNED
        IN_PROGRESS
        COMPLETED
    }

    class InfractionStatus {
        <<enumeration>>
        OPEN
        CLOSED
    }

    %% ─── Associations (verbe + multiplicités) ───────────────

    User "1" --> "0..*" OfficialPrice : fixe
    User "1" --> "0..*" Report : soumet
    User "1" --> "0..*" Mission : effectue
    User "1" --> "0..*" Infraction : constate
    User "1" --> "0..*" Notification : reçoit
    User "1" --> "0..*" Merchant : gère

    Product "1" --> "1..*" OfficialPrice : possède
    Product "1" --> "0..*" Report : est signalé dans

    Region "1" --> "0..*" OfficialPrice : couvre
    Region "1" --> "0..*" Report : localise
    Region "1" --> "0..*" Merchant : situe
    Region "1" --> "0..*" Mission : cible

    Report "1" --> "0..*" Infraction : génère
    Merchant "0..1" --> "0..*" Report : concerne
    Merchant "0..1" --> "0..*" Infraction : sanctionne

    %% ─── Associations énumérations ─────────────────────────
    User --> Role
    Report --> ReportStatus
    Report --> Priority
    Mission --> MissionStatus
    Infraction --> InfractionStatus
